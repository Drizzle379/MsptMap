{
	"schemaVersion": 1,
	"id": "msptmap",
	"version": "${version}",
	"name": "MsptMap",
	"description": "Draws a chunk mspt heatmap on Xaero's world map.",
	"authors": [
		"Drizzle"
	],
	"license": "MIT",
	"icon": "assets/msptmap/icon.png",
	"accessWidener": "${access_widener}",
	"contact": {
		"homepage": "https://github.com/Drizzle379/MsptMap",
		"sources": "https://github.com/Drizzle379/MsptMap",
		"issues": "https://github.com/Drizzle379/MsptMap/issues"
	},
	"environment": "*",
	"entrypoints": {
		"main": [
			"msptmap.MsptMapMod"
		],
		"client": [
			"msptmap.client.MsptMapClient"
		],
		"modmenu": [
			"msptmap.client.ModMenuIntegration"
		]
	},
	"mixins": [
		"msptmap.mixins.json",
		"msptmap.client.mixins.json"${extra_mixin_entry}
	],
	"jars": [
		{
			"file": "META-INF/jars/endec-0.1.12.jar"
		},
		{
			"file": "META-INF/jars/gson-0.1.7.jar"
		},
		{
			"file": "META-INF/jars/netty-0.1.6.jar"
		}
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "${minecraft_range}",
		"java": ">=${java_release}",
		"fabric-api": ">=${fabric_api_version}"
	},
	"suggests": {
		"xaeroworldmap": "*",
		"xaerominimap": "*",
		"modmenu": "*"
	}
}
